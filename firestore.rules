rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document (non-PII health check)
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // Global Primitives & Role Hierarchy
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCapabilityId(id) {
      return isValidId(id) && id.size() >= 24;
    }

    function isValidAppRef(ref) {
      return ref is string && ref.size() == 10 && ref.matches('^APP-[A-Z0-9]{6}$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string && emailKey.size() >= 5 && emailKey.size() <= 150 && emailKey.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidHmacKey(key) {
      return key is string && key.size() == 64 && key.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrapOwner() {
      return isVerifiedUser()
        && request.auth.token.email.lower() in ['joehennry33@gmail.com', 'joehenry33@gmail.com'];
    }

    function hasStaffDoc() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower()));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower())).data;
    }

    function isAdmin() {
      return isBootstrapOwner() || (hasStaffDoc() && staffData().active == true);
    }

    function isVerifier() {
      return isBootstrapOwner()
        || (hasStaffDoc() && staffData().active == true && staffData().role in ['super_admin', 'verification_officer']);
    }

    function isSuperAdmin() {
      return isBootstrapOwner()
        || (hasStaffDoc() && staffData().active == true && staffData().role == 'super_admin');
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'accountStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'accountStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 150
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && data.accountStatus in ['Active', 'Suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEnrolment(data) {
      return data.keys().hasAll([
          'ownerId', 'applicationRef', 'fullName', 'phoneNumber', 'email', 'hasPin',
          'packageAmount', 'packageLabel', 'acceptedTerms', 'intention', 'comment',
          'otpIssued', 'otpIssuedAt', 'otpExpiresAt', 'otpAttempts', 'otpUsed',
          'otpVerified', 'otpVerifiedAt', 'otpResendRequested', 'lastResendRequestedAt',
          'stage', 'status', 'accountStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'applicationRef', 'fullName', 'phoneNumber', 'email', 'hasPin',
          'packageAmount', 'packageLabel', 'acceptedTerms', 'intention', 'comment',
          'otpIssued', 'otpIssuedAt', 'otpExpiresAt', 'otpAttempts', 'otpUsed',
          'otpVerified', 'otpVerifiedAt', 'otpResendRequested', 'lastResendRequestedAt',
          'stage', 'status', 'accountStatus', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidAppRef(data.applicationRef)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 7 && data.phoneNumber.size() <= 20
        && data.email is string && data.email.size() <= 150
        && data.hasPin is bool
        && data.packageAmount is number && data.packageAmount >= 0 && data.packageAmount <= 1000000
        && data.packageLabel is string && data.packageLabel.size() <= 40
        && data.acceptedTerms is bool
        && data.intention in ['', 'Loan Support', 'Business', 'Education', 'Personal Goal', 'Emergency Relief']
        && data.comment is string && data.comment.size() <= 500
        && data.otpIssued is bool
        && (data.otpIssuedAt == null || data.otpIssuedAt is timestamp)
        && (data.otpExpiresAt == null || data.otpExpiresAt is timestamp)
        && data.otpAttempts is int && data.otpAttempts >= 0 && data.otpAttempts <= 5
        && data.otpUsed is bool
        && data.otpVerified is bool
        && (data.otpVerifiedAt == null || data.otpVerifiedAt is timestamp)
        && data.otpResendRequested is bool
        && (data.lastResendRequestedAt == null || data.lastResendRequestedAt is timestamp)
        && data.stage in ['stage1_submitted', 'otp_verified', 'final_submitted']
        && data.status in ['Pending', 'Verified', 'Rejected']
        && data.accountStatus in ['Active', 'Suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEnrolmentPin(data) {
      return data.keys().hasAll(['pinHash', 'createdAt'])
        && data.keys().hasOnly(['pinHash', 'createdAt'])
        && data.pinHash is string && data.pinHash.size() >= 20 && data.pinHash.size() <= 250
        && data.createdAt is timestamp;
    }

    function isValidOtpChallenge(data) {
      return data.keys().hasAll([
          'applicationRef', 'enrolmentId', 'otpIssued', 'otpExpiresAt',
          'otpAttempts', 'otpUsed', 'otpVerified', 'gatewayCommit',
          'sealedGatewayKey', 'gatewayProof', 'otpServerCommit',
          'otpSealedPayload', 'otpProof', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'applicationRef', 'enrolmentId', 'otpIssued', 'otpExpiresAt',
          'otpAttempts', 'otpUsed', 'otpVerified', 'gatewayCommit',
          'sealedGatewayKey', 'gatewayProof', 'otpServerCommit',
          'otpSealedPayload', 'otpProof', 'createdAt', 'updatedAt'
        ])
        && isValidAppRef(data.applicationRef)
        && isValidId(data.enrolmentId)
        && data.otpIssued is bool
        && (data.otpExpiresAt == null || data.otpExpiresAt is timestamp)
        && data.otpAttempts is int && data.otpAttempts >= 0 && data.otpAttempts <= 5
        && data.otpUsed is bool
        && data.otpVerified is bool
        && data.gatewayCommit is bytes && data.gatewayCommit.size() == 32
        && data.sealedGatewayKey is string && data.sealedGatewayKey.size() >= 20 && data.sealedGatewayKey.size() <= 512
        && data.gatewayProof is string && data.gatewayProof.size() <= 128
        && data.otpServerCommit is bytes && (data.otpServerCommit.size() == 0 || data.otpServerCommit.size() == 32)
        && data.otpSealedPayload is string && data.otpSealedPayload.size() <= 1024
        && data.otpProof is string && data.otpProof.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOtpRequest(data) {
      return data.keys().hasAll([
          'enrolmentId', 'applicationRef', 'ownerId', 'clientName',
          'phoneNumber', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'enrolmentId', 'applicationRef', 'ownerId', 'clientName',
          'phoneNumber', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.enrolmentId)
        && isValidAppRef(data.applicationRef)
        && isValidId(data.ownerId)
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 7 && data.phoneNumber.size() <= 20
        && data.status in ['Pending', 'Acknowledged']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'active', 'addedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'active', 'addedBy', 'createdAt', 'updatedAt'])
        && isValidEmailKey(data.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['super_admin', 'verification_officer', 'support_agent']
        && data.active is bool
        && data.addedBy is string && data.addedBy.size() >= 5 && data.addedBy.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'whatsappNumber', 'supportEmail', 'tier1Amount', 'tier2Amount',
          'tier3Amount', 'otpNoticeText', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'whatsappNumber', 'supportEmail', 'tier1Amount', 'tier2Amount',
          'tier3Amount', 'otpNoticeText', 'updatedAt'
        ])
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 25
        && data.supportEmail is string && data.supportEmail.size() <= 150
        && data.tier1Amount is number && data.tier1Amount >= 100 && data.tier1Amount <= 1000000
        && data.tier2Amount is number && data.tier2Amount >= 100 && data.tier2Amount <= 1000000
        && data.tier3Amount is number && data.tier3Amount >= 100 && data.tier3Amount <= 1000000
        && data.otpNoticeText is string && data.otpNoticeText.size() >= 5 && data.otpNoticeText.size() <= 300
        && data.updatedAt is timestamp;
    }

    function isValidPhoneAccountApp(data) {
      return data.keys().hasAll(['applicationRef', 'enrolmentId', 'sealedPinHash', 'createdAt'])
        && data.keys().hasOnly(['applicationRef', 'enrolmentId', 'sealedPinHash', 'createdAt'])
        && isValidAppRef(data.applicationRef)
        && isCapabilityId(data.enrolmentId)
        && data.sealedPinHash is string && data.sealedPinHash.size() >= 20 && data.sealedPinHash.size() <= 512
        && data.createdAt is timestamp;
    }

    function isValidAdminConsoleGate(data) {
      return data.keys().hasAll(['passwordHash', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['passwordHash', 'createdAt', 'updatedAt'])
        && data.passwordHash is string
        && data.passwordHash.size() == 168
        && data.passwordHash.matches('^scrypt\\$[a-f0-9]{32}\\$[a-f0-9]{128}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId}
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (isBootstrapOwner() || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().accountStatus == 'Active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isVerifier()
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // /enrolments/{enrolmentId}
    // -------------------------------------------------------------------------
    match /enrolments/{enrolmentId} {
      allow get: if isValidId(enrolmentId)
        && (isAdmin() || isCapabilityId(enrolmentId));

      allow list: if isVerifiedUser() && (isBootstrapOwner() || isAdmin());

      allow create: if isCapabilityId(enrolmentId)
        && isValidEnrolment(incoming())
        && incoming().ownerId == 'public_client'
        && incoming().hasPin == true
        && incoming().stage == 'stage1_submitted'
        && incoming().status == 'Pending'
        && incoming().accountStatus == 'Active'
        && incoming().packageAmount == 0
        && incoming().acceptedTerms == false
        && incoming().otpIssued == false
        && incoming().otpIssuedAt == null
        && incoming().otpExpiresAt == null
        && incoming().otpAttempts == 0
        && incoming().otpUsed == false
        && incoming().otpVerified == false
        && incoming().otpVerifiedAt == null
        && incoming().otpResendRequested == false
        && incoming().lastResendRequestedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/enrolments/$(enrolmentId)/private/pin)
        && existsAfter(/databases/$(database)/documents/otpChallenges/$(incoming().applicationRef));

      allow update: if isValidId(enrolmentId)
        && isValidEnrolment(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().applicationRef == existing().applicationRef
        && incoming().hasPin == existing().hasPin
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1A: Verifiers & Super Admins can edit client details & verification status (never OTP state)
          (
            isVerifier()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'phoneNumber', 'email', 'packageAmount', 'packageLabel',
              'intention', 'comment', 'status', 'accountStatus', 'updatedAt'
            ])
          )
          ||
          // Tier 1B: Support Agents can update support comments only (no OTP generation/editing)
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'comment', 'updatedAt'
            ])
          )
          ||
          // Tier 2: Client & Server-Proof OTP Transitions
          (
            isCapabilityId(enrolmentId)
            && existing().status == 'Pending'
            && existing().accountStatus == 'Active'
            && (
              // Sync 1: External OTP issued (requires atomic /otpChallenges update verified by gatewayProof)
              (
                existing().otpVerified == false
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.enrolmentId == enrolmentId
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpIssued == true
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpUsed == false
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpVerified == false
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpAttempts == 0
                && incoming().otpIssued == true
                && incoming().otpIssuedAt == request.time
                && incoming().otpExpiresAt == getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpExpiresAt
                && incoming().otpAttempts == 0
                && incoming().otpUsed == false
                && incoming().otpResendRequested == false
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'otpIssued', 'otpIssuedAt', 'otpExpiresAt', 'otpAttempts',
                  'otpUsed', 'otpResendRequested', 'updatedAt'
                ])
              )
              ||
              // Sync 2: Incorrect OTP attempt recorded (requires atomic /otpChallenges update)
              (
                existing().otpIssued == true
                && existing().otpUsed == false
                && existing().otpVerified == false
                && existing().otpAttempts < 5
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.enrolmentId == enrolmentId
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpAttempts == existing().otpAttempts + 1
                && incoming().otpAttempts == existing().otpAttempts + 1
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'otpAttempts', 'updatedAt'
                ])
              )
              ||
              // Sync 3: Server-verified OTP success -> unlock Second Form (requires atomic /otpChallenges proof)
              (
                existing().otpUsed == false
                && existing().otpVerified == false
                && existing().otpAttempts < 5
                && existing().stage == 'stage1_submitted'
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.enrolmentId == enrolmentId
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpVerified == true
                && getAfter(/databases/$(database)/documents/otpChallenges/$(existing().applicationRef)).data.otpUsed == true
                && incoming().otpVerified == true
                && incoming().otpUsed == true
                && incoming().otpVerifiedAt == request.time
                && incoming().otpResendRequested == false
                && incoming().stage == 'otp_verified'
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'otpVerified', 'otpUsed', 'otpVerifiedAt', 'otpResendRequested', 'stage', 'updatedAt'
                ])
              )
              ||
              // Action 4: Client OTP resend notification (strict 5-minute cooldown)
              (
                existing().otpVerified == false
                && (
                  existing().lastResendRequestedAt == null
                  || request.time >= existing().lastResendRequestedAt + duration.value(5, 'm')
                )
                && incoming().otpResendRequested == true
                && incoming().lastResendRequestedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'otpResendRequested', 'lastResendRequestedAt', 'updatedAt'
                ])
              )
              ||
              // Action 5: Second Form submission (ONLY allowed after OTP verified)
              (
                existing().stage == 'otp_verified'
                && existing().otpVerified == true
                && existing().otpUsed == true
                && incoming().stage == 'final_submitted'
                && incoming().acceptedTerms == true
                && incoming().packageAmount > 0
                && incoming().intention != ''
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'phoneNumber', 'packageAmount', 'packageLabel', 'acceptedTerms',
                  'intention', 'comment', 'stage', 'updatedAt'
                ])
              )
            )
          )
        );

      allow delete: if isValidId(enrolmentId) && isSuperAdmin();

      // Write-only isolated secret PIN hash (never readable by clients or admins)
      match /private/{docId} {
        allow read: if false;
        allow create: if docId == 'pin'
          && isCapabilityId(enrolmentId)
          && isValidEnrolmentPin(incoming())
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/enrolments/$(enrolmentId));
        allow update: if false;
        allow delete: if docId == 'pin' && isValidId(enrolmentId) && isSuperAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // /otpChallenges/{applicationRef}
    // Non-PII server-sealed OTP verification challenges with rotating proofs
    // -------------------------------------------------------------------------
    match /otpChallenges/{applicationRef} {
      allow get: if isValidAppRef(applicationRef);
      allow list: if false;

      allow create: if isValidAppRef(applicationRef)
        && isValidOtpChallenge(incoming())
        && incoming().applicationRef == applicationRef
        && isCapabilityId(incoming().enrolmentId)
        && incoming().otpIssued == false
        && incoming().otpExpiresAt == null
        && incoming().otpAttempts == 0
        && incoming().otpUsed == false
        && incoming().otpVerified == false
        && incoming().gatewayProof == ''
        && incoming().otpSealedPayload == ''
        && incoming().otpProof == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/enrolments/$(incoming().enrolmentId));

      allow update: if isValidAppRef(applicationRef)
        && isValidOtpChallenge(incoming())
        && incoming().applicationRef == existing().applicationRef
        && incoming().enrolmentId == existing().enrolmentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && hashing.sha256(incoming().gatewayProof) == existing().gatewayCommit
        && incoming().gatewayCommit != existing().gatewayCommit
        && (
          // External OTP issued (or re-issued after resend/expiry)
          (
            existing().otpVerified == false
            && incoming().otpIssued == true
            && incoming().otpExpiresAt is timestamp
            && incoming().otpExpiresAt > request.time
            && incoming().otpAttempts == 0
            && incoming().otpUsed == false
            && incoming().otpVerified == false
            && incoming().otpServerCommit.size() == 32
            && incoming().otpSealedPayload.size() >= 20
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'otpIssued', 'otpExpiresAt', 'otpAttempts', 'otpUsed',
              'gatewayCommit', 'sealedGatewayKey', 'gatewayProof',
              'otpServerCommit', 'otpSealedPayload', 'updatedAt'
            ])
          )
          ||
          // Failed attempt increment (max 5 attempts)
          (
            existing().otpIssued == true
            && existing().otpUsed == false
            && existing().otpVerified == false
            && existing().otpAttempts < 5
            && incoming().otpAttempts == existing().otpAttempts + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'otpAttempts', 'gatewayCommit', 'sealedGatewayKey', 'gatewayProof', 'updatedAt'
            ])
          )
          ||
          // Server-verified OTP match (enforces not expired, not used, <5 attempts, SHA-256 commit)
          (
            existing().otpIssued == true
            && existing().otpUsed == false
            && existing().otpVerified == false
            && existing().otpAttempts < 5
            && existing().otpExpiresAt is timestamp
            && request.time <= existing().otpExpiresAt
            && hashing.sha256(incoming().otpProof) == existing().otpServerCommit
            && incoming().otpUsed == true
            && incoming().otpVerified == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'otpUsed', 'otpVerified', 'gatewayCommit', 'sealedGatewayKey',
              'gatewayProof', 'otpProof', 'updatedAt'
            ])
          )
          ||
          // Server-verified client-entered external OTP (sent out-of-band without webhook pre-issuance; still requires gatewayProof)
          (
            existing().otpIssued == false
            && existing().otpUsed == false
            && existing().otpVerified == false
            && existing().otpAttempts < 5
            && incoming().otpUsed == true
            && incoming().otpVerified == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'otpUsed', 'otpVerified', 'gatewayCommit', 'sealedGatewayKey',
              'gatewayProof', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidAppRef(applicationRef) && isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // /otpRequests/{requestId}
    // Resend notifications displayed only in the admin panel
    // -------------------------------------------------------------------------
    match /otpRequests/{requestId} {
      allow get: if isValidId(requestId)
        && (isAdmin() || isCapabilityId(requestId));

      allow list: if isVerifiedUser() && (isBootstrapOwner() || isAdmin());

      allow create: if isCapabilityId(requestId)
        && isValidOtpRequest(incoming())
        && incoming().ownerId == 'public_client'
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/enrolments/$(incoming().enrolmentId))
        && getAfter(/databases/$(database)/documents/enrolments/$(incoming().enrolmentId)).data.otpResendRequested == true;

      allow update: if isValidId(requestId)
        && isAdmin()
        && isValidOtpRequest(incoming())
        && incoming().enrolmentId == existing().enrolmentId
        && incoming().applicationRef == existing().applicationRef
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().status == 'Acknowledged'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ]);

      allow delete: if isValidId(requestId) && isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // /staffAccess/{staffEmail}
    // -------------------------------------------------------------------------
    match /staffAccess/{staffEmail} {
      allow get: if isValidEmailKey(staffEmail)
        && isVerifiedUser()
        && (request.auth.token.email.lower() == staffEmail || isAdmin());

      allow list: if isVerifiedUser() && (isBootstrapOwner() || isAdmin());

      allow create: if isValidEmailKey(staffEmail)
        && isSuperAdmin()
        && isValidStaffMember(incoming())
        && incoming().email == staffEmail
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidEmailKey(staffEmail)
        && isSuperAdmin()
        && isValidStaffMember(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'role', 'active', 'updatedAt'
        ]);

      allow delete: if isValidEmailKey(staffEmail)
        && isSuperAdmin()
        && staffEmail != 'joehennry33@gmail.com';
    }

    // -------------------------------------------------------------------------
    // /settings/{settingId}
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();

      allow create: if isValidId(settingId)
        && isSuperAdmin()
        && isValidSystemSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isValidId(settingId)
        && isSuperAdmin()
        && isValidSystemSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'whatsappNumber', 'supportEmail', 'tier1Amount', 'tier2Amount',
          'tier3Amount', 'otpNoticeText', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /phoneAccounts/{phoneKey}/apps/{applicationRef}
    // Non-PII HMAC-SHA256 indexed lookup for client PIN login
    // -------------------------------------------------------------------------
    match /phoneAccounts/{phoneKey} {
      allow read, write: if false;

      match /apps/{applicationRef} {
        allow get: if isValidHmacKey(phoneKey) && isValidAppRef(applicationRef);
        allow list: if isValidHmacKey(phoneKey);

        allow create: if isValidHmacKey(phoneKey)
          && isValidAppRef(applicationRef)
          && isValidPhoneAccountApp(incoming())
          && incoming().applicationRef == applicationRef
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/enrolments/$(incoming().enrolmentId));

        allow update: if false;
        allow delete: if isValidHmacKey(phoneKey) && isValidAppRef(applicationRef) && isSuperAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // /adminConsoleGate/{gateId}
    // One-time claimable scrypt password hash for /admin-console URL protection
    // -------------------------------------------------------------------------
    match /adminConsoleGate/{gateId} {
      allow get: if gateId == 'primary';
      allow list: if false;

      allow create: if gateId == 'primary'
        && isValidAdminConsoleGate(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if gateId == 'primary'
        && isSuperAdmin()
        && isValidAdminConsoleGate(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'updatedAt']);

      allow delete: if false;
    }
  }
}
