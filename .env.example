# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXTERNAL_OTP_WEBHOOK_SECRET: Bearer token required by POST /api/external/otp-issued
# to register externally issued OTP verification challenges.
EXTERNAL_OTP_WEBHOOK_SECRET=

# OTP_HMAC_SECRET: Server-side AES-256-GCM key used to seal OTP payloads and gateway keys.
OTP_HMAC_SECRET=

# ADMIN_CONSOLE_PASSWORD: Optional server-side password required to unlock the /admin-console URL.
# When set, this overrides any first-run password claimed through the Admin Console setup UI.
ADMIN_CONSOLE_PASSWORD=
