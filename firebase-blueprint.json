{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered staff/admin user profile information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "accountStatus": {
          "type": "string",
          "enum": ["Active", "Suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "accountStatus", "createdAt", "updatedAt"]
    },
    "Enrolment": {
      "title": "Enrolment",
      "description": "Client enrolment and verification submission record (PIN hash isolated in private subcollection)",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicationRef": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^APP-[A-Z0-9]{6}$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "hasPin": {
          "type": "boolean"
        },
        "packageAmount": {
          "type": "number"
        },
        "packageLabel": {
          "type": "string",
          "maxLength": 40
        },
        "acceptedTerms": {
          "type": "boolean"
        },
        "intention": {
          "type": "string",
          "enum": ["", "Loan Support", "Business", "Education", "Personal Goal", "Emergency Relief"]
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        },
        "otpIssued": {
          "type": "boolean"
        },
        "otpIssuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "otpExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "otpAttempts": {
          "type": "number"
        },
        "otpUsed": {
          "type": "boolean"
        },
        "otpVerified": {
          "type": "boolean"
        },
        "otpVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "otpResendRequested": {
          "type": "boolean"
        },
        "lastResendRequestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stage": {
          "type": "string",
          "enum": ["stage1_submitted", "otp_verified", "final_submitted"]
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Verified", "Rejected"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["Active", "Suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "applicationRef",
        "fullName",
        "phoneNumber",
        "email",
        "hasPin",
        "packageAmount",
        "packageLabel",
        "acceptedTerms",
        "intention",
        "comment",
        "otpIssued",
        "otpAttempts",
        "otpUsed",
        "otpVerified",
        "otpResendRequested",
        "stage",
        "status",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "EnrolmentPin": {
      "title": "EnrolmentPin",
      "description": "Write-only private salted scrypt hash of client secret PIN (never readable by clients or admins)",
      "type": "object",
      "properties": {
        "pinHash": {
          "type": "string",
          "minLength": 20,
          "maxLength": 250
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["pinHash", "createdAt"]
    },
    "OtpChallenge": {
      "title": "OtpChallenge",
      "description": "Non-PII server-sealed OTP verification challenge keyed by applicationRef",
      "type": "object",
      "properties": {
        "applicationRef": {
          "type": "string",
          "pattern": "^APP-[A-Z0-9]{6}$",
          "maxLength": 16
        },
        "enrolmentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "otpIssued": {
          "type": "boolean"
        },
        "otpExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "otpAttempts": {
          "type": "number"
        },
        "otpUsed": {
          "type": "boolean"
        },
        "otpVerified": {
          "type": "boolean"
        },
        "gatewayCommit": {
          "type": "string",
          "description": "SHA-256 commitment bytes of rotating server gateway key"
        },
        "sealedGatewayKey": {
          "type": "string",
          "maxLength": 512
        },
        "gatewayProof": {
          "type": "string",
          "maxLength": 128
        },
        "otpServerCommit": {
          "type": "string",
          "description": "SHA-256 commitment bytes of server verification token"
        },
        "otpSealedPayload": {
          "type": "string",
          "maxLength": 1024
        },
        "otpProof": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "applicationRef",
        "enrolmentId",
        "otpIssued",
        "otpAttempts",
        "otpUsed",
        "otpVerified",
        "gatewayCommit",
        "sealedGatewayKey",
        "gatewayProof",
        "otpServerCommit",
        "otpSealedPayload",
        "otpProof",
        "createdAt",
        "updatedAt"
      ]
    },
    "OtpRequest": {
      "title": "OtpRequest",
      "description": "Client OTP resend notification displayed only in the admin panel",
      "type": "object",
      "properties": {
        "enrolmentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicationRef": {
          "type": "string",
          "pattern": "^APP-[A-Z0-9]{6}$",
          "maxLength": 16
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Acknowledged"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enrolmentId",
        "applicationRef",
        "ownerId",
        "clientName",
        "phoneNumber",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Role-based staff and admin access entry keyed by lowercase email",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "verification_officer", "support_agent"]
        },
        "active": {
          "type": "boolean"
        },
        "addedBy": {
          "type": "string",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "active", "addedBy", "createdAt", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Publicly readable non-PII platform configuration managed by super admins",
      "type": "object",
      "properties": {
        "whatsappNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 150
        },
        "tier1Amount": {
          "type": "number"
        },
        "tier2Amount": {
          "type": "number"
        },
        "tier3Amount": {
          "type": "number"
        },
        "otpNoticeText": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "whatsappNumber",
        "supportEmail",
        "tier1Amount",
        "tier2Amount",
        "tier3Amount",
        "otpNoticeText",
        "updatedAt"
      ]
    },
    "PhoneAccountApp": {
      "title": "PhoneAccountApp",
      "description": "HMAC-keyed non-PII index linking a client's normalized mobile number to their enrolment capability ID and AES-GCM sealed PIN hash",
      "type": "object",
      "properties": {
        "applicationRef": {
          "type": "string",
          "pattern": "^APP-[A-Z0-9]{6}$",
          "maxLength": 16
        },
        "enrolmentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sealedPinHash": {
          "type": "string",
          "minLength": 20,
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["applicationRef", "enrolmentId", "sealedPinHash", "createdAt"]
    },
    "AdminConsoleGate": {
      "title": "AdminConsoleGate",
      "description": "One-time claimed scrypt password hash protecting access to the /admin-console URL",
      "type": "object",
      "properties": {
        "passwordHash": {
          "type": "string",
          "minLength": 168,
          "maxLength": 168,
          "pattern": "^scrypt\\$[a-f0-9]{32}\\$[a-f0-9]{128}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["passwordHash", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Client/staff user profile documents"
    },
    "/enrolments/{enrolmentId}": {
      "schema": { "$ref": "#/entities/Enrolment" },
      "description": "Client enrolment submissions across Registration, OTP Verification, Second Form, and Admin review"
    },
    "/enrolments/{enrolmentId}/private/{docId}": {
      "schema": { "$ref": "#/entities/EnrolmentPin" },
      "description": "Isolated non-readable salted hash of client-created secret PIN"
    },
    "/otpChallenges/{applicationRef}": {
      "schema": { "$ref": "#/entities/OtpChallenge" },
      "description": "Non-PII server-sealed OTP verification state and rotating cryptographic commitments"
    },
    "/otpRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OtpRequest" },
      "description": "OTP resend notifications sent by clients and displayed only in the admin panel"
    },
    "/staffAccess/{staffEmail}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Role-based access control directory for admin portal users"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Platform configuration such as WhatsApp number and package pricing"
    },
    "/phoneAccounts/{phoneKey}/apps/{applicationRef}": {
      "schema": { "$ref": "#/entities/PhoneAccountApp" },
      "description": "HMAC-SHA256 keyed lookup entries for PIN-authenticated client account sign-in"
    },
    "/adminConsoleGate/{gateId}": {
      "schema": { "$ref": "#/entities/AdminConsoleGate" },
      "description": "Server-verified salted scrypt password gate for the /admin-console URL"
    }
  }
}
